* Perform a CMS370 CREXX build of the assembler
&ERROR &EXIT &RETCODE

&DEBUG = &1
&SRCDISK = &2
&BINDISK = &3
&PARMFN = CREXX&DEBUG

* assembler/CMakeLists.txt
EXEC CRXGCC RXASASSM C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXASDSL  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXASEROR C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXASGRMR C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXASLIB  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXASMAIN C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXASOPT  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXASSCAN C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXASTOKE C &SRCDISK ( CMS PARM &PARMFN CSECT

TXTLIB GEN RXASLIB RXASMAIN RXASTOKE RXASEROR RXASSCAN RXASOPT RXASGRMR RXASASSM RXASLIB RXASDSL

GLOBAL TXTLIB RXASLIB AVL_TREE CMSUTIL PLATFORM GCCLIB
LOAD RXASMAI@ RXASTOK@ RXASERO@ RXASSCA@ RXASOPT@ RXASGRM@ RXASASS@ RXASLIB@ RXASDSL@ CMSUTIL@ AVLTREE@ PLATFOR@ ( CLEAR NOAUTO RESET @@MAIN
GENMOD RXAS&DEBUG ( FROM RXASMAI@
&TYPE RXAS&DEBUG -V
RXAS&DEBUG -V
COPY RXAS&DEBUG MODULE A = = &BINDISK ( OLDDATE REPLACE
COPY LOAD MAP A RXAS&DEBUG = &BINDISK ( OLDDATE REPLACE
ERASE * TEXT A
ERASE RXAS&DEBUG MODULE A
ERASE LOAD MAP A

&EXIT 0
