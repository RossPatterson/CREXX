* Perform a CMS370 CREXX build of the compiler
&ERROR &EXIT &RETCODE

&DEBUG = &1
&SRCDISK = &2
&BINDISK = &3
&PARMFN = CREXX&DEBUG

EXEC CRXGCC REXBSCAN C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXCPB03  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXCPB04  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXCPB05  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXCPB06  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXCPB07  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXCPB09  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXCPB10  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXCPBPAR C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXCPFUNC C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXCPMAIN C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXCPOPAR C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXCPOPGR C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXCPOSCN C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXCPSYMB C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCUTIL   C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCACORE  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCAPRT   C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCAREWRT C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCASVAL  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCAWALK  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCDIAGFB C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXCPDSL  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXCPEMIT C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCECORE  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCEEXPR  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCEFLOW  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCEMETA  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCEPROC  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCEREG   C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCEXIT   C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCFIXUP  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCHICTL  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCINLINE C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RXCPOPT  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCSRCTR  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCVCHECK C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCVORCH  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCVPLGIN C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCVSYM   C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCVTRANS C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCVTYPE  C &SRCDISK ( CMS PARM &PARMFN CSECT
EXEC CRXGCC RCINSTR  C &SRCDISK ( CMS PARM &PARMFN CSECT

TXTLIB GEN  RXCLIB   RXCPMAIN RCACORE  RCAPRT   RCAWALK  RCUTIL   RCDIAGFB RXCPDSL  RCHICTL  RCSRCTR  RXCPOSCN RXCPOPGR RXCPOPAR REXBSCAN RXCPB03  RXCPB04  RXCPB05  RXCPB06  RXCPB07  RXCPB09  RXCPB10
   RXCPBPAR RCVSYM   RCVTYPE  RCVTRANS RCAREWRT RCVCHECK RCVPLGIN RCVORCH RXCPSYMB RCFIXUP  RCASVAL  RCINLINE RXCPEMIT RCECORE  RCEREG   RCEEXPR  RCEFLOW RCEPROC  RCEMETA  RXCPOPT  RXCPFUNC RCEXIT

GLOBAL TXTLIB RXCLIB RXASLIB RXBVML CMSUTIL AVL_TREE PLATFORM GCCLIB
LOAD                 RXCPMAI@ RCACORE@ RCAPRT@@ RCAWALK@ RCUTIL@@ RCDIAGF@ RXCPDSL@ RCHICTL@ RCSRCTR@ RXCPOSC@ RXCPOPG@ RXCPOPA@ REXBSCAN@ RXCPB03@ RXCPB04@ RXCPB05@ RXCPB06@ RXCPB07@ RXCPB09@ RXCPB10@
   RXCPBPA@ RCVSYM@@ RCVTYPE@ RCVTRAN@ RCAREWR@ RCVCHEC@ RCVPLGI@ RCVORCH@ RXCPSYM@ RCFIXUP@ RCASVAL@ RCINLIN@ RXCPEMI@ RCECORE@ RCEREG@@ RCEEXPR@ RCEFLOW@ RCEPROC@ RCEMETA@ RXCPOPT@ RXCPFUN@ RCEXIT@@ CMSUTIL@ PLATFOR@
   ( CLEAR NOAUTO RESET RXCPMAI@
