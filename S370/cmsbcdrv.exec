* Perform a CMS370 CREXX build of the CREXX driver
&ERROR &EXIT &RETCODE

&DEBUG = &1
&SRCDISK = &2
&BINDISK = &3
&PARMFN = CREXX&DEBUG

RXC -i "bin;lib/plugins/system" -o crexx CREXX
RXAS CREXX
RXLINK -s -o crexx_linked crexx bin/library
RXCPACK -o crexx crexx_linked
EXEC CRXGCC CREXX C A ( CMS PARM &PARMFN CSECT

GLOBAL TXTLIB GCCLIB
LOAD CREXX (CLEAR NOAUTO RESET @@MAIN
GENMOD CREXX&DEBUG ( FROM CREXX@@@
&TYPE CREXX&DEBUG -V
CREXX&DEBUG -V
COPY CREXX&DEBUG MODULE A = = &BINDISK ( OLDDATE REPLACE
COPY LOAD MAP A CREXX&DEBUG = &BINDISK ( OLDDATE REPLACE
ERASE CREXX&DEBUG MODULE A

&EXIT 0
