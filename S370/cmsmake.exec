   Arg Debug?, SourceDisk, BinaryDisk

if 0 then do
   /* Bare Interpreter - Threaded Version */
   /* TODO
   'GCC RXVMMAIN C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
      In file included from platform.h:71,
                       from <stdin>:34:
