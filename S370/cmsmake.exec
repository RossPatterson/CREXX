   'LOAD RXVMMAI@ RXVMINT@ RXVMLOA@ INTERRU@ RXSPAWN@ EXITFUN@ RXPAFUN@' ,
      'RXVMRUN@ ( CLEAR NOAUTO RESET @@MAIN'
   'GENMOD RXVM' || Debug? '( FROM RXVMMAI@'
   Say 'RXVM' || Debug? '-V'
   'RXVM' || Debug? '-V'
   'COPY RXVM' || Debug? 'MODULE A = =' BinaryDisk '( OLDDATE REPLACE'
   'COPY LOAD MAP A RXVM' || Debug? '=' BinaryDisk '( OLDDATE REPLACE'
   'ERASE RXVM' || Debug? 'MODULE A'
   'ERASE LOAD MAP A'
end

   /* Bare Interpreter - Bytecode Version */
   'GLOBAL TXTLIB RXBVML MC_DECIMAL_MANUAL GCCLIB'
   'LOAD RXVMMAI@ RXVMLIB@ RXVML@@@ RXVMIN1@ RXVMIN2@ RXVMLOA@ INTERRU@          EXITFUN@ RXPAFUN@' ,
      'RXVMRUN@ ( CLEAR NOAUTO RESET @@MAIN'
   'GENMOD RXBVM' || Debug? '( FROM RXVMLIB@'
   Say 'RXBVM' || Debug? '-V'
   'RXBVM' || Debug? '-V'
   'COPY RXBVM' || Debug? 'MODULE A = =' BinaryDisk '( OLDDATE REPLACE'
   'COPY LOAD MAP A RXBVM' || Debug? '=' BinaryDisk '( OLDDATE REPLACE'
   'ERASE RXBVM' || Debug? 'MODULE A'

if 0 then do
   /* Interpreter linked to CREXX Stdlib - Threaded Version */
   ParmFn = 'C_ICT' || Debug?
   'GCC RXVMMAIN C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXVMINTP C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXVMLOAD C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC INTERRUP C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
