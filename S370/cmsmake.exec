/* This exec builds CREXX */
Signal on Error
'SPOOL CONS START TO * PURGE'
Trace C
Arg SourceDisk BinaryDisk

If SourceDisk = '' then SourceDisk = 'D'
If BinaryDisk = '' then BinaryDisk = 'E'

/* Build DEBUG versions */
Call Build 'D', SourceDisk, BinaryDisk
/* Build non-DEBUG versions */
Call Build '',SourceDisk, BinaryDisk

Call Test SourceDisk
Exit 0

Error:
Say 'Error' RC 'in line' SigL':' SourceLine(SigL)
Exit RC

Build: Procedure
   Arg Debug?, SourceDisk, BinaryDisk

   /* The order of these builds matters, because of included TEXT files. */
   Call BuildCMS          Debug?, SourceDisk, BinaryDisk
   Call BuildPlatform     Debug?, SourceDisk, BinaryDisk
   Call BuildAvlTree      Debug?, SourceDisk, BinaryDisk
   Call BuildAssembler    Debug?, SourceDisk, BinaryDisk
   Call BuildCPacker      Debug?, SourceDisk, BinaryDisk
   Call BuildInterpreter1 Debug?, SourceDisk, BinaryDisk
   Call BuildCompiler     Debug?, SourceDisk, BinaryDisk
   Call BuildLinker       Debug?, SourceDisk, BinaryDisk
   Call BuildDisassembler Debug?, SourceDisk, BinaryDisk
   /* Call BuildDebugger     Debug?, SourceDisk, BinaryDisk */
   Call BuildInterpreter2 Debug?, SourceDisk, BinaryDisk
   Call BuildRxPA         Debug?, SourceDisk, BinaryDisk
   /* Call BuildLib          Debug?, SourceDisk, BinaryDisk */
   /* Call BuildDemos        Debug?, SourceDisk, BinaryDisk */
   /* Call BuildTests        Debug?, SourceDisk, BinaryDisk */
   Call BuildBin          Debug?, SourceDisk, BinaryDisk
   Call BuildCRexxDriver  Debug?, SourceDisk, BinaryDisk

   /* CLEANUP */
   'LISTFILE * TXTLIB A ( EXEC'
   'EXPLOIT COPY &FN &FT A = =' BinaryDisk '(OLDDATE REPLACE'
   'ERASE * TXTLIB A'
   'ERASE * MODULE A'
   'ERASE LOAD MAP A'

Return

BuildCMS: Procedure
   Arg Debug?, SourceDisk, BinaryDisk
   ParmFn = 'CREXX' || Debug?

   /* S370/... */
   'GCC CMSUTIL  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'

   'TXTLIB GEN CMSUTIL  CMSUTIL'
   'ERASE * TEXT A'

Return

BuildPlatform: Procedure
   Arg Debug?, SourceDisk, BinaryDisk
   ParmFn = 'CREXX' || Debug?

   /* platform/CMakeLists.txt */
   'GCC PLATFORM C' SourceDisk '( CMS PARM' ParmFn 'CSECT'

   'TXTLIB GEN PLATFORM PLATFORM'
   'ERASE * TEXT A'

Return


BuildAvlTree: Procedure
   Arg Debug?, SourceDisk, BinaryDisk
   ParmFn = 'CREXX' || Debug?

   /* AVLTREE/CMakeLists.txt */
   'GCC AVLTREE  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'

   'TXTLIB GEN AVL_TREE AVLTREE'
   'ERASE * TEXT A'

Return


BuildAssembler: Procedure
   Arg Debug?, SourceDisk, BinaryDisk
   ParmFn = 'CREXX' || Debug?

   /* assembler/CMakeLists.txt */
   'GCC RXASASSM C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXASDSL  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXASEROR C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXASGRMR C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXASLIB  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXASMAIN C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXASOPT  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXASSCAN C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXASTOKE C' SourceDisk '( CMS PARM' ParmFn 'CSECT'

   'TXTLIB GEN RXASLIB RXASMAIN RXASTOKE RXASEROR RXASSCAN RXASOPT' ,
       'RXASGRMR RXASASSM RXASLIB RXASDSL'

   'GLOBAL TXTLIB RXASLIB AVL_TREE CMSUTIL PLATFORM GCCLIB'
   'LOAD               RXASMAI@ RXASTOK@ RXASERO@ RXASSCA@ RXASOPT@' ,
      'RXASGRM@ RXASASS@ RXASLIB@ RXASDSL@' ,
      'CMSUTIL@ AVLTREE@ PLATFOR@' ,
      '( CLEAR NOAUTO RESET @@MAIN'
   'GENMOD RXAS' || Debug? '( FROM RXASMAI@'
   Say 'RXAS' || Debug? '-V'
   'RXAS' || Debug? '-V'
   'COPY RXAS' || Debug? 'MODULE A = =' BinaryDisk '( OLDDATE REPLACE'
   'COPY LOAD MAP A RXAS' || Debug? '=' BinaryDisk '( OLDDATE REPLACE'
   'ERASE * TEXT A'
   'ERASE RXAS' || Debug? 'MODULE A'
   'ERASE LOAD MAP A'

Return


BuildCPacker: Procedure
   Arg Debug?, SourceDisk, BinaryDisk
   ParmFn = 'CREXX' || Debug?

   /* cpacker/CMakeLists.txt */
   'GCC RXCPACK C' SourceDisk '( CMS PARM' ParmFn 'CSECT'

   'TXTLIB GEN RXCPACK RXCPACK'

   'GLOBAL TXTLIB RXCPACK CMSUTIL PLATFORM GCCLIB'
   'LOAD RXCPACK@ CMSUTIL@ PLATFOR@ ( CLEAR NOAUTO RESET @@MAIN'
   'GENMOD RXCPACK' || Debug? '(FROM RXCPACK@'
   Say 'RXCPACK' || Debug? '-V'
   'RXCPACK' || Debug? '-V'
   'COPY RXCPACK' || Debug? 'MODULE A = =' BinaryDisk '( OLDDATE REPLACE'
   'COPY LOAD MAP A RXCPACK' || Debug? '=' BinaryDisk '( OLDDATE REPLACE'
   'ERASE * TEXT A'
   'ERASE RXCPACK' || Debug? 'MODULE A'
   'ERASE LOAD MAP A'

Return


BuildCompiler: Procedure
   Arg Debug?, SourceDisk, BinaryDisk
   ParmFn = 'CREXX' || Debug?

   'GCC REXBSCAN C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXCPB03  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXCPB04  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXCPB05  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXCPB06  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXCPB07  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXCPB09  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXCPB10  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXCPBPAR C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXCPFUNC C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXCPMAIN C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXCPOPAR C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXCPOPGR C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXCPOSCN C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXCPSYMB C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCUTIL   C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCACORE  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCAPRT   C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCAREWRT C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCASVAL  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCAWALK  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCDIAGFB C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXCPDSL  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXCPEMIT C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCECORE  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCEEXPR  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCEFLOW  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCEMETA  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCEPROC  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCEREG   C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCEXIT   C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCFIXUP  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCHICTL  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCINLINE C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXCPOPT  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCSRCTR  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCVCHECK C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCVORCH  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCVPLGIN C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCVSYM   C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCVTRANS C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCVTYPE  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RCINSTR  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'

   'TXTLIB GEN  RXCLIB   RXCPMAIN RCACORE  RCAPRT   RCAWALK  RCUTIL' ,
      'RCDIAGFB RXCPDSL  RCHICTL  RCSRCTR  RXCPOSCN RXCPOPGR RXCPOPAR REXBSCAN' ,
      'RXCPB03  RXCPB04  RXCPB05  RXCPB06  RXCPB07  RXCPB09  RXCPB10' ,
      'RXCPBPAR RCVSYM   RCVTYPE  RCVTRANS RCAREWRT RCVCHECK RCVPLGIN RCVORCH' ,
      'RXCPSYMB RCFIXUP  RCASVAL  RCINLINE RXCPEMIT RCECORE  RCEREG   RCEEXPR  RCEFLOW' ,
      'RCEPROC  RCEMETA  RXCPOPT  RXCPFUNC RCEXIT'

   'GLOBAL TXTLIB RXCLIB RXASLIB RXBVML CMSUTIL AVL_TREE PLATFORM GCCLIB'
   'LOAD                 RXCPMAI@ RCACORE@ RCAPRT@@ RCAWALK@ RCUTIL@@' ,
      'RCDIAGF@ RXCPDSL@ RCHICTL@ RCSRCTR@ RXCPOSC@ RXCPOPG@ RXCPOPA@ REXBSCAN@' ,
      'RXCPB03@ RXCPB04@ RXCPB05@ RXCPB06@ RXCPB07@ RXCPB09@ RXCPB10@' ,
      'RXCPBPA@ RCVSYM@@ RCVTYPE@ RCVTRAN@ RCAREWR@ RCVCHEC@ RCVPLGI@ RCVORCH@' ,
      'RXCPSYM@ RCFIXUP@ RCASVAL@ RCINLIN@ RXCPEMI@ RCECORE@ RCEREG@@ RCEEXPR@ RCEFLOW@' ,
      'RCEPROC@ RCEMETA@ RXCPOPT@ RXCPFUN@ RCEXIT@@ CMSUTIL@ PLATFOR@',
      '( CLEAR NOAUTO RESET RXCPMAI@'
   /* TODO
      THE FOLLOWING NAMES ARE UNDEFINED:
       DECNUMBE
       GET@RXVM - interpreter\rxvmplugin\rxvmplugin_framework.h:get_rxvmplugin()
       ISNAN
       ISINF
       SIGNBIT
       SRC@INST
       ATOLL
       TRUNC
       @FN0268  - rxpa/rxpa.h:load_plugin()
       RUN      - interpreter/rxvmin2.c:run()
       @FN0157  - interpreter/rxvmintp.h:rxvm_mprintf()
       @FN0156  - interpreter/rxvmintp.h:redrwriteclose()
       RXVM@ADD
       RISETSAY
       RXVM@SOC
       @FN0314  - interpreter/rxvmload.c:rxvm_getstring()
       @FN0315  - interpreter/rxvmload.c:rxvm_setstring()
       @FN0316  - interpreter/rxvmload.c:rxvm_setint()
       @FN0317  - interpreter/rxvmload.c:rxvm_getint()
       @FN0318  - interpreter/rxvmload.c:rxvm_setfloat()
       @FN0319  - interpreter/rxvmload.c:rxvm_getfloat()
       @FN0320  - interpreter/rxvmload.c:rxvm_setnativepayload()
       @FN0321  - interpreter/rxvmload.c:rxvm_getnativepayload()
       RXVM@GET
       RXVM@INS
       RXVM@REM
       RXVM@SWA
       RIRSTSAY
       RXVM@LIN
       VSNPRINT
   */
   'GENMOD RXC' || Debug? '( FROM RXCPMAI@'

   Say 'RXC' || Debug? '-V'
   'RXC' || Debug? '-V'
   'COPY RXC' || Debug? 'MODULE A = =' BinaryDisk '( OLDDATE REPLACE'
   'COPY LOAD MAP A RXC' || Debug? '=' BinaryDisk '( OLDDATE REPLACE'
   'ERASE * TEXT A'
   'ERASE RXC' || Debug? 'MODULE A'
   'ERASE LOAD MAP A'
EXIT 0

Return


BuildLinker: Procedure
   Arg Debug?, SourceDisk, BinaryDisk
   ParmFn = 'CREXX' || Debug?

   'GCC RXLKMAIN C' SourceDisk '( CMS PARM' ParmFn 'CSECT'

   'GLOBAL TXTLIB CMSUTIL PLATFORM GCCLIB'
   'LOAD RXLKMAI@ CMSUTIL@ PLATFOR@ ( CLEAR NOAUTO RESET @@MAIN'
   'GENMOD RXLINK' || Debug? '( FROM RXLKMAI@'
   Say 'RXLINK' || Debug? '-H'
   'RXLINK' || Debug? '-H'
   'COPY RXLINK' || Debug? 'MODULE A = =' BinaryDisk '( OLDDATE REPLACE'
   'COPY LOAD MAP A RXLINK' || Debug? '=' BinaryDisk '( OLDDATE REPLACE'
   'ERASE RXLINK' || Debug? 'MODULE A'
   'ERASE LOAD MAP A'
   'ERASE * TEXT A'

Return


BuildDisassembler: Procedure
   Arg Debug?, SourceDisk, BinaryDisk
   ParmFn = 'CREXX' || Debug?

   'GCC RXDAMAIN C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXDADISM C' SourceDisk '( CMS PARM' ParmFn 'CSECT'

   'GLOBAL TXTLIB AVL_TREE CMSLIB PLATFORM GCCLIB'
   'LOAD RXDAMAI@ RXDADIS@ CMSUTIL@ PLATFOR@ ( CLEAR NOAUTO RESET @@MAIN'
   'GENMOD RXDAS' || Debug? '( FROM RXDAMAI@'
   Say 'RXDAS' || Debug? '-V'
   'RXDAS' || Debug? '-V'
   'COPY RXDAS' || Debug? 'MODULE A = =' BinaryDisk '( OLDDATE REPLACE'
   'COPY LOAD MAP A RXDAS' || Debug? '=' BinaryDisk '( OLDDATE REPLACE'
   'ERASE RXDAS' || Debug? 'MODULE A'
   'ERASE LOAD MAP A'
   'ERASE * TEXT A'

Return


BuildInterpreter1: Procedure
   Arg Debug?, SourceDisk, BinaryDisk

   /* TODO - What do we do about these?
      set(CMAKE_C_STANDARD 99) # enables inline keyword
      set(CMAKE_C_FLAGS_RELEASE "-O3 -DNDEBUG") # Can do more I am sure but this is about as good as it get in practice
      set(CREXX_DEFAULT_TLS_BACKEND OPENSSL)
  */

   /* RXPA Shim Library - Provides standard rxpa_ symbols for standalone targets */
   ParmFn = 'CREXX' || Debug?
   'GCC RXPASHIM C' SourceDisk '( CMS PARM' ParmFn 'CSECT'

   /* Packed Library */
   /* TODO
   'RXCPACK -o library bin/library'
      There's no bin/ on CMS.
   'GCC LIBRARY  C A ( CMS PARM' ParmFn 'CSECT'
      Source file LIBRARY C A not found.
   */

   /* Bare Interpreter - Bytecode Version */
   ParmFn = 'C_IBB' || Debug?
   'GCC RXVML    C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXVMLIB  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXVMMAIN C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXVMIN1  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   /* TODO
   'GCC RXVMIN2  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
      In file included from rxvmintp.c:81,
                       from <stdin>:6:
      cmstime.h:1:2: #error This header does not exist in CMS
      DMSSMN109S VIRTUAL STORAGE CAPACITY EXCEEDED, 00010008 BYTES REQUESTED.
      DMSABN148T SYSTEM ABEND 80A CALLED FROM F929B2.
   */
   'GCC RXVMLOAD C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC INTERRUP C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   /* No RXSPAWN in CMS.
   'GCC RXSPAWN  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   */
   'GCC EXITFUNC C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   'GCC RXPAFUNC C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
   /* TODO
      In file included from rxvmintp.h:30,
                       from <stdin>:36:
      cmsfns.h:308:1: warning: "rxvm_getsignaltext" redefined
      In file included from <stdin>:30:
      cmsfns.h:628:1: warning: this is the location of the previous definition
      In file included from rxvmintp.h:30,
                       from <stdin>:36:
      cmsfns.h:309:1: warning: "rxvm_getsignalcode" redefined
      In file included from <stdin>:30:
      cmsfns.h:629:1: warning: this is the location of the previous definition
      In file included from rxvmintp.h:30,
                       from <stdin>:36:
      cmsfns.h:314:1: warning: "rxvm_callfunc" redefined
      In file included from <stdin>:30:
      cmsfns.h:627:1: warning: this is the location of the previous definition
      Return code 4 from GCC of RXPAFUNC
   */
   'GCC RXVMRUN  C' SourceDisk '( CMS PARM' ParmFn 'CSECT'
/*
   'TXTLIB GEN RXBVML RXVMMAIN RXVMLIB RXVML    RXVMIN1  RXVMIN2  RXVMLOAD INTERRUP RXSPAWN  EXITFUNC RXPAFUNC RXVMRUN'
*/
   'TXTLIB GEN RXBVML RXVMMAIN RXVMLIB RXVML    RXVMIN1           RXVMLOAD INTERRUP          EXITFUNC RXPAFUNC RXVMRUN'
Return


