* Perform a CMS370 CREXX build
&ERROR &EXIT &RETCODE

&DEBUG = &1
&SRCDISK = &2
&BINDISK = &3

EXEC CMSBCMS  &DEBUG &SRCDISK &BINDISK
EXEC CMSBPLAT &DEBUG &SRCDISK &BINDISK
EXEC CMSBAVLT &DEBUG &SRCDISK &BINDISK
EXEC CMSBASM  &DEBUG &SRCDISK &BINDISK
EXEC CMSBCPAK &DEBUG &SRCDISK &BINDISK
EXEC CMSBINT1 &DEBUG &SRCDISK &BINDISK
EXEC CMSBCOMP &DEBUG &SRCDISK &BINDISK
EXEC CMSBLINK &DEBUG &SRCDISK &BINDISK
EXEC CMSBDISA &DEBUG &SRCDISK &BINDISK
*EXEC CMSBDBG  &DEBUG &SRCDISK &BINDISK
EXEC CMSBINT2 &DEBUG &SRCDISK &BINDISK
EXEC CMSBRXPA &DEBUG &SRCDISK &BINDISK
*EXEC CMSBLIB  &DEBUG &SRCDISK &BINDISK
*EXEC CMSBDEMO &DEBUG &SRCDISK &BINDISK
*EXEC CMSBTEST &DEBUG &SRCDISK &BINDISK
EXEC CMSBBIN  &DEBUG &SRCDISK &BINDISK
EXEC CMSBCDRV &DEBUG &SRCDISK &BINDISK

* Clean up
LISTFILE * TXTLIB A ( EXEC
EXEC EXPLOIT COPY &LITERAL &FN &LITERAL &FT A = = &BINDISK (OLDDATE REPLACE
ERASE * TXTLIB A
ERASE * MODULE A
ERASE LOAD MAP A

&EXIT 0
